---
import '../styles/docs.css';
import { getCollection } from 'astro:content';
import { SECTIONS, REPO_URL, CONSOLE_URL, HOME_ID, hrefFor } from '../lib/nav';
import Search from '../components/Search.astro';

interface Props {
  id: string;
  title: string;
  description: string;
  headings?: { depth: number; slug: string; text: string }[];
  wide?: boolean;
  sources?: string[];
  checked?: string[];
  updated?: string;
  editPath?: string;
}
const { id, title, description, headings = [], wide = false, sources = [], checked = [], updated, editPath } = Astro.props;

const all = (await getCollection('docs')).sort((a, b) => (a.data.order - b.data.order) || a.id.localeCompare(b.id));
const section = id.split('/')[0];
const sectionTitle = SECTIONS.find((s) => s.id === section)?.title ?? '';
const groups = SECTIONS.map((s) => ({
  ...s,
  pages: all.filter((d) => d.id.split('/')[0] === s.id).map((d) => ({ id: d.id, label: d.data.nav ?? d.data.title, sub: d.id.split('/').length > 2 })),
})).filter((g) => g.pages.length);
const flat = groups.flatMap((g) => g.pages);
const i = flat.findIndex((p) => p.id === id);
const prev = i > 0 ? flat[i - 1] : null;
const next = i >= 0 && i < flat.length - 1 ? flat[i + 1] : null;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const canonical = new URL(hrefFor(id), Astro.site).href;
const isRef = section === 'reference';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{id === HOME_ID ? 'Software Factory docs' : `${title} · Software Factory docs`}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="article" />
    <link rel="preload" href="/fonts/Geist-Regular.otf" as="font" type="font/otf" crossorigin />
    <script is:inline>
      // Apply the saved theme before first paint so the page never flashes.
      (function () {
        var t = 'system';
        try { t = localStorage.getItem('sf-theme') || 'system'; } catch (e) {}
        var dark = t === 'dark' || (t === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        document.documentElement.dataset.themePref = t;
      })();
    </script>
  </head>
  <body>
    <a href="#content" class="sr-only focus:not-sr-only">Skip to content</a>
    <header class="site-header">
      <button type="button" class="icon-btn menu-btn" aria-label="Open the docs menu" aria-expanded="false" data-menu>
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2 5h14M2 9h14M2 13h14" /></svg>
      </button>
      <a href="/" class="brand">
        <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><rect width="22" height="22" rx="6" fill="currentColor" /><path d="M6 8h10M6 11h7M6 14h10" stroke="var(--bg)" stroke-width="1.6" stroke-linecap="round" /></svg>
        Software Factory <span>Docs</span>
      </a>
      <button type="button" class="search-btn" data-search-open aria-label="Search the docs">
        <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="7" cy="7" r="5" /><path d="M11 11l3.5 3.5" /></svg>
        <span class="label">Search docs, keys, error codes</span>
        <kbd>/</kbd>
      </button>
      <nav class="top-nav" aria-label="Top">
        <a href="/" aria-current={isRef ? 'false' : 'true'}>Guides</a>
        <a href="/reference/settings/" aria-current={isRef ? 'true' : 'false'}>Reference</a>
        <a href={`${REPO_URL}/commits/main`}>Changes</a>
        <a href={CONSOLE_URL}>Console ↗</a>
      </nav>
      <button type="button" class="icon-btn" data-theme-toggle aria-label="Theme: match system. Switch theme">
        <svg data-icon="light" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="8" cy="8" r="3" /><path d="M8 1v2M8 13v2M1 8h2M13 8h2M3 3l1.4 1.4M11.6 11.6L13 13M3 13l1.4-1.4M11.6 4.4L13 3" /></svg>
        <svg data-icon="dark" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M13.5 9.5A5.5 5.5 0 016.5 2.5a5.5 5.5 0 107 7z" /></svg>
        <svg data-icon="system" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="1.5" y="2.5" width="13" height="9" rx="1.5" /><path d="M5.5 14.5h5" /></svg>
      </button>
    </header>

    <div class="shell">
      <nav class="sidebar" aria-label="Docs" data-pagefind-ignore>
        {groups.map((g) => (
          <>
            <h2>{g.title}</h2>
            <ul>
              {g.pages.map((p) => (
                <li class={p.sub ? 'sub' : ''}><a href={hrefFor(p.id)} aria-current={p.id === id ? 'page' : undefined}>{p.label}</a></li>
              ))}
            </ul>
          </>
        ))}
      </nav>

      <div class="main">
        <article class:list={['article', { wide }]} id="content" data-pagefind-body data-pagefind-filter={`section:${sectionTitle}`}>
          {sectionTitle && <nav class="crumbs" aria-label="Breadcrumb" data-pagefind-ignore>{sectionTitle}</nav>}
          <h1 data-pagefind-meta="title">{title}</h1>
          <p class="lede">{description}</p>
          {(updated || checked.length > 0) && (
            <div class="meta" data-pagefind-ignore>
              {updated && <span>Updated {updated}</span>}
              {checked.length > 0 && <span>Checked against {checked.map((c, n) => <>{n > 0 && ', '}<code>{c}</code></>)}</span>}
            </div>
          )}
          <div class="prose">
            <slot />
          </div>
          <nav class="pager" aria-label="Previous and next" data-pagefind-ignore>
            {prev && <a href={hrefFor(prev.id)} class="prev"><small>Previous</small>{prev.label}</a>}
            {next && <a href={hrefFor(next.id)} class="next"><small>Next</small>{next.label}</a>}
          </nav>
          <div class="foot-meta" data-pagefind-ignore>
            {editPath && <a href={`${REPO_URL}/edit/main/${editPath}`}>Edit this page</a>}
            {sources.length > 0 && <span>Sources: {sources.map((s, n) => <>{n > 0 && ', '}<code>{s}</code></>)}</span>}
          </div>
        </article>

        {toc.length > 1 && (
          <aside class="toc" aria-label="On this page" data-pagefind-ignore>
            <h2>On this page</h2>
            <ul>
              {toc.map((h) => <li class={`d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}
            </ul>
          </aside>
        )}
      </div>
    </div>

    <Search />

    <script>
      const root = document.documentElement;
      const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;
      const order = ['system', 'light', 'dark'] as const;
      const label: Record<string, string> = { system: 'match system', light: 'light', dark: 'dark' };
      const media = window.matchMedia('(prefers-color-scheme: dark)');
      function apply(pref: string) {
        const dark = pref === 'dark' || (pref === 'system' && media.matches);
        root.dataset.theme = dark ? 'dark' : 'light';
        root.dataset.themePref = pref;
        btn.setAttribute('aria-label', `Theme: ${label[pref]}. Switch theme`);
        btn.querySelectorAll<SVGElement>('[data-icon]').forEach((s) => (s.style.display = s.dataset.icon === pref ? '' : 'none'));
      }
      apply(root.dataset.themePref || 'system');
      btn.addEventListener('click', () => {
        const cur = root.dataset.themePref || 'system';
        const next = order[(order.indexOf(cur as (typeof order)[number]) + 1) % order.length];
        try { localStorage.setItem('sf-theme', next); } catch {}
        apply(next);
      });
      media.addEventListener('change', () => apply(root.dataset.themePref || 'system'));

      // Mobile menu.
      const menu = document.querySelector<HTMLButtonElement>('[data-menu]')!;
      menu.addEventListener('click', () => {
        const open = document.body.classList.toggle('nav-open');
        menu.setAttribute('aria-expanded', String(open));
      });

      // Copy buttons on code blocks.
      document.querySelectorAll<HTMLPreElement>('.prose pre').forEach((pre) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'copy-btn';
        b.textContent = 'Copy';
        b.addEventListener('click', async () => {
          try { await navigator.clipboard.writeText(pre.querySelector('code')?.innerText ?? pre.innerText); b.textContent = 'Copied'; }
          catch { b.textContent = 'Press Ctrl+C'; }
          setTimeout(() => (b.textContent = 'Copy'), 1600);
        });
        pre.appendChild(b);
      });

      // A "#" link after each section heading, for copying a link to it.
      document.querySelectorAll<HTMLHeadingElement>('.prose :is(h2, h3, h4)[id]').forEach((h) => {
        const a = document.createElement('a');
        a.className = 'anchor';
        a.href = `#${h.id}`;
        a.setAttribute('aria-label', `Link to ${h.textContent}`);
        a.textContent = '#';
        h.appendChild(a);
      });

      // Wrap tables so wide ones scroll inside a box, not the page. Tables of
      // three or more columns also label each cell with its header, so on a
      // phone every row can stack into a card instead of scrolling sideways.
      document.querySelectorAll<HTMLTableElement>('.prose table').forEach((t) => {
        if (t.parentElement?.classList.contains('table-wrap')) return;
        const w = document.createElement('div');
        w.className = 'table-wrap';
        t.replaceWith(w);
        w.appendChild(t);
        const heads = [...t.querySelectorAll('thead th')].map((th) => th.textContent?.trim() ?? '');
        if (heads.length < 3) return;
        w.classList.add('table-stack');
        t.querySelectorAll('tbody tr').forEach((tr) => {
          [...tr.children].forEach((td, i) => {
            if (heads[i]) td.setAttribute('data-label', heads[i]);
            if (!td.textContent?.trim() && !td.querySelector('img')) td.classList.add('empty');
          });
        });
      });

      // Highlight the section in view in "On this page".
      const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
      if (links.length) {
        const targets = links.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1)))).filter(Boolean) as HTMLElement[];
        const onScroll = () => {
          let cur = targets[0];
          for (const t of targets) if (t.getBoundingClientRect().top < 120) cur = t;
          links.forEach((a) => a.classList.toggle('active', a.hash.slice(1) === cur?.id));
        };
        document.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      }
    </script>
  </body>
</html>
