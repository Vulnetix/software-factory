---
import { getEntry, render } from 'astro:content';
import Doc from '../layouts/Doc.astro';
import { HOME_ID } from '../lib/nav';

const entry = (await getEntry('docs', HOME_ID))!;
const { Content, headings } = await render(entry);
---
<Doc id={entry.id} title={entry.data.title} description={entry.data.description} headings={headings}
  sources={entry.data.sources} checked={entry.data.checked} updated={entry.data.updated}
  editPath={`src/content/docs/${entry.id}.md`}>
  <Content />
</Doc>
