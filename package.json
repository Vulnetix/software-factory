{
  "name": "software-factory-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.14.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist && node scripts/sitemap.mjs dist",
    "preview": "astro preview",
    "check-links": "node scripts/check-links.mjs dist",
    "inventory:scan": "node scripts/inventory-scan.mjs && node scripts/gen-reference.mjs",
    "inventory:check": "node scripts/inventory-check.mjs --strict --coverage COVERAGE.md"
  },
  "resolutions": {
    "sharp": "0.35.5",
    "smol-toml": "1.9.0",
    "source-map-js": "1.2.2",
    "undici": "8.12.3",
    "vite": "8.3.5",
    "zod": "4.6.7",
    "http-cache-semantics": "4.3.0",
    "nanoid@npm:^3.3.20": "3.3.19"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.1",
    "astro": "^7.3.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "pagefind": "^1.5.2",
    "tailwindcss": "^4.3.3"
  }
}
